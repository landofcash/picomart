{
  "name": "@picomart/mcp",
  "version": "1.0.2",
  "description": "Local Codex MCP bridge for Picomart browser-approved testnet orders",
  "type": "module",
  "bin": {
    "picomart-mcp": "dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build",
    "start": "node --env-file-if-exists=.env.local dist/server.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@picomart/order-protocol": "file:vendor/picomart-order-protocol.tgz",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/qrcode": "^1.5.6",
    "jose": "6.2.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "private": true
}
