{
  "schemaVersion": 1,
  "templateId": "picomart-neutral-storefront",
  "templateVersion": "1.4.0-delivery.1",
  "sourceProject": "picomart-storefront-template",
  "buildMode": "production",
  "outputDirectory": "dist",
  "publicConfig": "public/storefront.json",
  "editablePaths": [
    "src/storefront/pages/**",
    "src/storefront/sections/**",
    "src/storefront/theme.css"
  ],
  "protectedPaths": [
    "src/app/**",
    "src/assets/**",
    "src/lib/**",
    "src/components/**",
    "src/context/**",
    "src/main.tsx",
    "src/App.tsx",
    "src/config.ts",
    "src/index.css",
    "src/vite-env.d.ts",
    "index.html",
    "public/storefront.json",
    "public/logo-32x32.png",
    "package.json",
    "package-lock.json",
    ".nvmrc",
    "vite.config.ts",
    "tsconfig*.json",
    "eslint.config.js",
    "tooling/**",
    "tests/**",
    "playwright.config.ts",
    "template/**",
    "vendor/**"
  ],
  "suppliedAssetsPath": "public/shop-assets/",
  "buildEnvironment": {
    "node": "24.11.0",
    "npm": "11.17.0",
    "lockfile": "package-lock.json",
    "lockfileSha256": "a7befa6f1f744cff5791bc158da64ac564448663a215cb28f6c3eb25c8f9f5e2",
    "lockfileHashNormalization": "UTF-8 with LF line endings",
    "playwright": "1.63.0",
    "browser": "chromium",
    "setup": [
      "npm ci",
      "npx playwright install --with-deps chromium"
    ]
  },
  "validationCommands": [
    "npm run typecheck",
    "npm run lint",
    "npm run build",
    "npm test"
  ],
  "fixtures": [
    "template/fixtures/pantry.json",
    "template/fixtures/studio.json"
  ],
  "notes": [
    "One maintained starting design; merchant copies become revision artifacts.",
    "Railway environment/checkpoint creation and enforcement of the editing contract belong to Phase 2 and the builder.",
    "Local Windows checks may use PLAYWRIGHT_CHANNEL=msedge; the sandbox should install the pinned Playwright Chromium runtime."
  ]
}
