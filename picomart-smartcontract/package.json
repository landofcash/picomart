{
  "name": "picomart-smartcontract",
  "version": "1.0.1",
  "description": "Picomart escrow and message commitments for Tempo Moderato",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "export:tempo": "hardhat compile && node scripts/export-tempo-abi.cjs",
    "check:tempo-abi": "hardhat compile && node scripts/export-tempo-abi.cjs --check",
    "preflight:tempo": "hardhat run scripts/preflight-tempo.cjs --network moderato",
    "deploy:testnet": "hardhat run scripts/deploy.js --network moderato"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "2.28.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@picomart/order-protocol": "file:vendor/picomart-order-protocol.tgz"
  }
}
