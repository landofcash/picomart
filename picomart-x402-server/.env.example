PORT=3402
NODE_ENV=development
PICOMART_SYNC_ORIGIN=http://localhost:3000
PICOMART_RESOURCE_ORIGIN=http://localhost:3402
PICOMART_TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
PICOMART_CATALOG_ORIGINS=https://cdn.picomart.zkbytes.com
PICOMART_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Fresh quote signing key, separate from all wallet keys. Generate locally when enabling the service.
PICOMART_QUOTE_SIGNING_KID=
PICOMART_QUOTE_SIGNING_KEY_PKCS8=
PICOMART_QUOTE_PUBLIC_KEY=
# Optional additional trusted public keys for in-window recovery after quote-key rotation.
PICOMART_QUOTE_PUBLIC_KEYS={}
# In-memory storage is local development only. Hosted production requires private Redis.
PICOMART_REDIS_URL=memory://
PICOMART_RECOVERY_SECONDS=86400
PICOMART_SYNC_RETRY_SECONDS=5
