{
  "name": "@picomart/x402-server",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "dev": "node --env-file-if-exists=.env.local --import tsx src/server.ts",
    "test": "vitest run",
    "generate-quote-key": "tsx scripts/generate-quote-key.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@picomart/order-protocol": "file:vendor/picomart-order-protocol.tgz",
    "cors": "^2.8.5",
    "ethers": "6.17.0",
    "express": "^5.1.0",
    "jose": "^6.1.3",
    "redis": "^5.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
