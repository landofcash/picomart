PORT=4180
# A dedicated listener/origin for generated content. Never route it to the API port.
PREVIEW_PORT=4181
BUILDER_PREVIEW_ORIGIN=http://127.0.0.1:4181
BUILDER_PREVIEW_TTL_SECONDS=900
# Public delivery runs independently of private previews on a third origin.
PUBLIC_PORT=4184
BUILDER_PUBLIC_ORIGIN=http://127.0.0.1:4184
BUNNY_PUBLIC_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_PUBLIC_STORAGE_ZONE=picomart-storefronts-public
BUNNY_PUBLIC_STORAGE_KEY=
BUNNY_PUBLIC_BASE_URL=
HOST=127.0.0.1
NODE_ENV=development
BUILDER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://seller.picomart.zkbytes.com
BUILDER_NETWORKS=moderato
BUILDER_STORAGE_PREFIX=picomart-tempo-moderato-builder-v2
# Exactly one coordinator process for this prefix. No rolling overlap.
BUILDER_COORDINATOR_COUNT=1
# Enable for the hosted service with a Railway volume mounted at /coordinator.
BUILDER_REQUIRE_DEPLOYMENT_VOLUME=false
BUILDER_CHALLENGE_TTL_SECONDS=300
BUILDER_SESSION_TTL_SECONDS=43200
BUILDER_MAX_OPERATIONS=50000
BUILDER_MAX_PENDING_WRITES=32
BUILDER_MAX_QUEUED_JOBS_PER_SHOP=10
BUILDER_SYNC_ORIGIN=https://sync.picomart.zkbytes.com
BUILDER_TEMPO_RPC_ORIGIN=https://rpc.moderato.tempo.xyz
BUNNY_PRIVATE_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_PRIVATE_STORAGE_ZONE=picomart-storefronts-private
BUNNY_PRIVATE_STORAGE_KEY=
# Enable generation only in the single active coordinator for this storage prefix.
BUILDER_WORKER_ENABLED=false
MAX_CONCURRENT_BUILDS=2
MAX_CONCURRENT_BUILDS_PER_SHOP=1
MAX_BUILD_ATTEMPTS=2
WORKER_POLL_MS=2000
BUILD_TIMEOUT_SECONDS=600
ATTEMPT_TIMEOUT_SECONDS=1800
MODEL_TIMEOUT_SECONDS=240
MODEL_MAX_OUTPUT_TOKENS=16000
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
RAILWAY_PROJECT_ID=
# Required when the worker is enabled. Must match the prepared checkpoint and token scope.
# Independent of the hosted service's RAILWAY_ENVIRONMENT_ID; no implicit default.
RAILWAY_SANDBOX_ENVIRONMENT_ID=
RAILWAY_AUTH_TYPE=project-token
RAILWAY_API_TOKEN=
