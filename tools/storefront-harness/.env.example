RAILWAY_PROJECT_ID=
# Required sandbox/checkpoint environment. RAILWAY_ENVIRONMENT_ID is accepted as a fallback.
RAILWAY_SANDBOX_ENVIRONMENT_ID=
# Use a token here, or pass --railway-cli-auth to reuse your local Railway login.
RAILWAY_API_TOKEN=
# Account/workspace token: bearer. Environment-scoped project token: project-token.
RAILWAY_AUTH_TYPE=bearer
# Generation and publication credentials stay in this local coordinator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
BUNNY_PRIVATE_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_PRIVATE_STORAGE_ZONE=
BUNNY_PRIVATE_STORAGE_KEY=
BUNNY_PUBLIC_STORAGE_ENDPOINT=https://storage.bunnycdn.com
BUNNY_PUBLIC_STORAGE_ZONE=
BUNNY_PUBLIC_STORAGE_KEY=
BUNNY_PUBLIC_BASE_URL=
STOREFRONT_RESOLVER_BASE_URL=
BUILD_TIMEOUT_SECONDS=600
ATTEMPT_TIMEOUT_SECONDS=1800
MAX_REPAIR_ATTEMPTS=1
MODEL_TIMEOUT_SECONDS=240
MODEL_MAX_OUTPUT_TOKENS=16000
MAX_SOURCE_BYTES=10485760
MAX_ARTIFACT_BYTES=52428800
